{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -4 -s -m 2 -X POST \"http://${NEBULADECK_HOST:-nebuladeck.local}/api/hook?event=SessionStart\" >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -4 -s -m 2 -X POST \"http://${NEBULADECK_HOST:-nebuladeck.local}/api/hook?event=UserPromptSubmit\" >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "t=$(sed -n 's/.*\"tool_name\" *: *\"\\([^\"]*\\)\".*/\\1/p' | head -n 1); curl -4 -s -m 2 -X POST \"http://${NEBULADECK_HOST:-nebuladeck.local}/api/hook?event=PreToolUse&tool=$t\" >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "m=$(sed -n 's/.*\"message\" *: *\"\\([^\"]*\\)\".*/\\1/p' | head -n 1); case \"$m\" in *\"waiting for your input\"*) k=idle;; *) k=attn;; esac; curl -4 -s -m 2 -X POST \"http://${NEBULADECK_HOST:-nebuladeck.local}/api/hook?event=Notification&kind=$k\" >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -4 -s -m 2 -X POST \"http://${NEBULADECK_HOST:-nebuladeck.local}/api/hook?event=Stop\" >/dev/null 2>&1 &"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -4 -s -m 2 -X POST \"http://${NEBULADECK_HOST:-nebuladeck.local}/api/hook?event=SessionEnd\" >/dev/null 2>&1 &"
          }
        ]
      }
    ]
  }
}
